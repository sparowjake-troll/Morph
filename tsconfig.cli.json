{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./dist/types",
    "noEmit": false
  },
  "include": [
    "src/cli/**/*",
    "src/config/**/*",
    "src/core/**/*",
    "src/extraction/**/*",
    "src/generation/**/*",
    "src/quality/**/*",
    "src/incremental/**/*",
    "src/figma/**/*"
  ],
  "exclude": ["src/app/**/*", "src/components/**/*", "node_modules"]
}
